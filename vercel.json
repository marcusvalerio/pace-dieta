{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/termos",
      "destination": "/legal/termos.html"
    },
    {
      "source": "/privacidade",
      "destination": "/legal/privacidade.html"
    }
  ],
  "redirects": [
    {
      "source": "/site",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/site/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}